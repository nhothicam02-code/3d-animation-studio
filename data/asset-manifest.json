  "characterArchitecture": {
    "body": "one-full-body-mesh",
    "deformation": "glTF morph targets / Blender Shape Keys",
    "characterRootTransform": [
      "x",
      "y",
      "z"
    ],
    "itemTransform": [
      "positionX",
      "positionY",
      "positionZ",
      "scaleX",
      "scaleY",
      "scaleZ",
      "rotationX",
      "rotationY",
      "rotationZ"
    ],
    "clothingCompatibility": "Matching morph targets on garments or fitted variants are required for deformation."
  },
  "shapeKeyContract": {
    "bodyAssetCategory": "body",
    "glTF": "Each body mesh may expose morphTargetDictionary and morphTargetInfluences.",
    "naming": "Use stable unique names across body meshes; values stored per character in shapeKeys.",
    "recommendedNames": [
      "Head_Size",
      "Head_Width",
      "Eye_Size",
      "Eye_Spacing",
      "Neck_Length",
      "Shoulder_Width",
      "Torso_Length",
      "Body_Width",
      "Chest_Size",
      "Waist_Size",
      "Belly_Size",
      "Hip_Width",
      "Butt_Size",
      "Arm_Length",
      "Arm_Width",
      "Leg_Length",
      "Leg_Width",
      "Hand_Size",
      "Foot_Size"
    ],
    "range": {
      "min": -1,
      "max": 1,
      "step": 0.01
    }
  }
