{
  "schemaVersion": 1,
  "bodyArchitecture": "single-full-body-mesh",
  "coordinateSystem": {
    "up": "Y",
    "forward": "-Z",
    "units": "meters"
  },
  "bodyAsset": {
    "category": "body",
    "required": true,
    "fileFormat": "glb",
    "shapeKeys": "glTF morph targets"
  },
  "recommendedShapeKeys": [
    "Head_Size",
    "Head_Width",
    "Head_Length",
    "Eye_Size",
    "Eye_Spacing",
    "Neck_Length",
    "Neck_Width",
    "Shoulder_Width",
    "Torso_Length",
    "Body_Width",
    "Chest_Size",
    "Waist_Size",
    "Belly_Size",
    "Hip_Width",
    "Butt_Size",
    "Arm_Length",
    "Arm_Width",
    "Leg_Length",
    "Leg_Width",
    "Hand_Size",
    "Foot_Size"
  ],
  "morphRange": {
    "min": -1,
    "max": 1,
    "step": 0.01
  },
  "characterRootTransform": {
    "axes": [
      "x",
      "y",
      "z"
    ],
    "bounds": null
  },
  "itemTransform": {
    "position": {
      "axes": [
        "x",
        "y",
        "z"
      ],
      "bounds": null
    },
    "scale": [
      "x",
      "y",
      "z"
    ],
    "rotationDegrees": [
      "x",
      "y",
      "z"
    ]
  },
  "clothing": {
    "strategy": "matching-morph-targets-or-fitted-variants",
    "warning": "Static garments do not automatically deform with body Shape Keys."
  }
}
