            {
              "id": "walk-lylo-3",
              "type": "tts",
              "start": 17.8,
              "text": "Thôi bình tĩnh, lát về kiểm tra. Ơ... sao trời tối nhanh vậy?",
              "lang": "vi",
              "voice": "",
              "ch": "zs100sko3",
              "lip": true,
              "hb": false,
              "hbs": 1,
              "rate": 1,
