            },
            {
              "id": "walk-lyly-2",
              "type": "tts",
              "start": 7.1,
              "text": "À mà khoan... hình như lúc ra khỏi nhà tớ quên khóa cửa phòng thì phải.",
              "lang": "vi",
              "voice": "",
              "ch": "vd705w1g1",
              "lip": true,
              "hb": false,
              "hbs": 1,
              "rate": 1,
              "pitch": 1,
              "vol": 1,
              "dur": 3.7,
              "ovhE": true,
              "ovhB": true,
              "ovMy": -20.2,
              "ovMs": 0.14,
              "ovMx": 12.7
            },
            {
              "id": "walk-lyly-3",
              "type": "tts",
              "start": 14.1,
              "text": "Tớ nhớ mang chìa khóa, nhưng không nhớ có xoay khóa hay chưa nữa...",
              "lang": "vi",
              "voice": "",
              "ch": "vd705w1g1",
              "lip": true,
              "hb": false,
              "hbs": 1,
              "rate": 1,
              "pitch": 1,
              "vol": 1,
              "dur": 3.5,
              "ovhE": true,
              "ovhB": true,
              "ovMy": -20.2,
              "ovMs": 0.14,
              "ovMx": 12.7
            },
            {
              "id": "walk-lyly-4",
              "type": "tts",
              "start": 20.6,
              "text": "Chết rồi, mưa rơi rồi! Chạy nhanh thôi, tớ không muốn đồ trong phòng bị ướt đâu!",
              "lang": "vi",
              "voice": "",
              "ch": "vd705w1g1",
              "lip": true,
              "hb": false,
              "hbs": 1,
              "rate": 1,
              "pitch": 1,
              "vol": 1,
              "dur": 4,
              "ovhE": true,
              "ovhB": true,
              "ovMy": -20.2,
              "ovMs": 0.14,
              "ovMx": 12.7
            },
            {
              "id": "walk-lyly-5",
              "type": "tts",
              "start": 28.3,
              "text": "Nhanh lên! Tớ chỉ mong cửa phòng vẫn đóng và mọi thứ còn nguyên!",
              "lang": "vi",
              "voice": "",
              "ch": "vd705w1g1",
              "lip": true,
              "hb": false,
              "hbs": 1,
              "rate": 1,
              "pitch": 1,
              "vol": 1,
              "dur": 3.5,
              "ovhE": true,
              "ovhB": true,
              "ovMy": -20.2,
              "ovMs": 0.14,
              "ovMx": 12.7
            },
            {
              "id": "walk-lyly-6",
              "type": "tts",
              "start": 35.5,
              "text": "Phù... cửa vẫn đóng! May quá, lần sau tớ nhất định kiểm tra kỹ trước khi đi.",
              "lang": "vi",
              "voice": "",
              "ch": "vd705w1g1",
              "lip": true,
              "hb": false,
              "hbs": 1,
              "rate": 1,
              "pitch": 1,
